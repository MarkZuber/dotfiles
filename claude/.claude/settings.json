{
  "permissions": {
    "allow": [
      "Read(~/repos/*)",
      "Edit(~/repos/*)",
      "Read(~/wt/*)",
      "Edit(~/wt/*)"
    ],
    "defaultMode": "plan",
    "additionalDirectories": [
      "~/repos",
      "~/wt"
    ]
  },
  "skillOverrides": {
    "find-skills": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/mark.zuber/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash '/Users/mark.zuber/.config/herdr/scripts/mr-token.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/mark.zuber/.claude/hooks/worktree-on-plan-exit.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/mark.zuber/.config/herdr/scripts/mr-token.sh'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash '/Users/mark.zuber/.config/herdr/scripts/notify.sh' finished",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/mark.zuber/.config/herdr/scripts/notify.sh' 'needs input'",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true
}
