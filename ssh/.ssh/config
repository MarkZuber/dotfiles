# Linked to ~/.ssh/config by scripts/link-dotfiles.sh. Public repo: no hosts, users or keys here.
# Put real Host blocks in ~/.ssh/config.local (untracked). It is included first because ssh
# uses the FIRST value it finds for each option, so anything there beats the defaults below.
Include ~/.ssh/config.local

Host *
  # Keep idle sessions alive through NAT/VPN timeouts: probe every 15s, give up after 4 misses.
  ServerAliveInterval 15
  ServerAliveCountMax 4
  # Load a key into the agent the first time it is used, and (macOS) remember its passphrase
  # in the keychain. IgnoreUnknown lets Linux's ssh skip the macOS-only option.
  IgnoreUnknown UseKeychain
  AddKeysToAgent yes
  UseKeychain yes
  # No ForwardAgent: forwarding your agent to every host lets any of them use your keys.
