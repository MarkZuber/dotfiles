nvim/.config/nvim/lazy-lock.json
.DS_Store
mscript/
prompts/

# Claude Code and herdr keep state, transcripts and sockets next to their config. Only the
# files listed in scripts/link-dotfiles.sh belong here; these patterns make sure the rest can't
# be committed by accident if a whole directory ever gets copied in.
claude/.claude/backups/
claude/.claude/cache/
claude/.claude/file-history/
claude/.claude/history.jsonl
claude/.claude/ide/
claude/.claude/paste-cache/
claude/.claude/plans/
claude/.claude/plugins/
claude/.claude/policy-limits.json
claude/.claude/projects/
claude/.claude/remote-settings.json
claude/.claude/session-env/
claude/.claude/sessions/
claude/.claude/settings.local.json
claude/.claude/shell-snapshots/
claude/.claude/tasks/
claude/.claude/telemetry/
claude/.claude/*.doctor-backup
herdr/.config/herdr/*.log
herdr/.config/herdr/*.sock
herdr/.config/herdr/.plugins.lock
herdr/.config/herdr/plugins.json
herdr/.config/herdr/plugins/
herdr/.config/herdr/release-notes.json
herdr/.config/herdr/session.json
