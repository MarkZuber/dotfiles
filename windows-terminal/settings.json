{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions": 
    [
        {
            "command": 
            {
                "action": "closeTab"
            },
            "id": "User.closeTab.0"
        }
    ],
    "copyFormatting": "none",
    "copyOnSelect": true,
    "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
    "keybindings": 
    [
        {
            "id": "Terminal.SplitPaneDown",
            "keys": "alt+shift+minus"
        },
        {
            "id": "Terminal.SplitPaneRight",
            "keys": "alt+shift+plus"
        },
        {
            "id": "Terminal.MoveFocusDown",
            "keys": "ctrl+shift+down"
        },
        {
            "id": "Terminal.MoveFocusRight",
            "keys": "ctrl+shift+right"
        },
        {
            "id": "Terminal.MoveFocusLeft",
            "keys": "ctrl+shift+left"
        },
        {
            "id": "Terminal.MoveFocusUp",
            "keys": "ctrl+shift+up"
        },
        {
            "id": "User.closeTab.0",
            "keys": "ctrl+w"
        },
        {
            "id": "Terminal.PasteFromClipboard",
            "keys": "ctrl+v"
        },
        {
            "id": "Terminal.FindText",
            "keys": "ctrl+shift+f"
        },
        {
            "id": "Terminal.OpenNewTab",
            "keys": "ctrl+t"
        },
        {
            "id": "Terminal.PrevTab",
            "keys": "ctrl+shift+tab"
        },
        {
            "id": "Terminal.CopyToClipboard",
            "keys": "ctrl+c"
        },
        {
            "id": "Terminal.NextTab",
            "keys": "ctrl+tab"
        }
    ],
    "newTabMenu": 
    [
        {
            "type": "remainingProfiles"
        }
    ],
    "profiles": 
    {
        "defaults": 
        {
            "antialiasingMode": "cleartype",
            "backgroundImageOpacity": 1,
            "closeOnExit": "graceful",
            "colorScheme": "ZubeDark",
            "cursorHeight": 25,
            "cursorShape": "bar",
            "font": 
            {
                "face": "ComicShannsMono Nerd Font Mono",
                "size": 18
            },
            "opacity": 100,
            "padding": "8",
            "scrollbarState": "hidden",
            "useAcrylic": false
        },
        "list": 
        [
            {
                "commandline": "pwsh.exe",
                "font": 
                {
                    "size": 14
                },
                "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
                "hidden": false,
                "name": "PowerShell",
                "source": "Windows.Terminal.PowershellCore",
